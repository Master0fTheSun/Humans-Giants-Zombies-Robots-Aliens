//@version=6
indicator("Model B v2.0 – SMC Intraday", overlay=true, max_boxes_count=200, max_lines_count=200)

// ── INPUTS ─────────────────────────────────────────────────────────────────

sma200Len    = input.int(200,   "200 SMA")
sma20Len     = input.int(20,    "20 SMA")
atrLen       = input.int(14,    "ATR Length")
atrMult      = input.float(1.5, "ATR Multiplier",      step=0.1)
rr           = input.float(2.0, "Risk : Reward",        step=0.1)
swingLen     = input.int(5,     "Swing Length",          minval=3, maxval=20,
               tooltip="Bars on each side of a pivot. Higher = fewer, more significant swings.")
showOB       = input.bool(true,  "Show Order Blocks")
showFVG      = input.bool(true,  "Show FVGs (trend-aligned)")
useSMA20Exit = input.bool(true,  "Exit on SMA20 Cross")
useDisc      = input.bool(false, "Discount / Premium Filter",
               tooltip="Longs only below 50% of last swing range; shorts only above.")
useSession   = input.bool(true,  "NY Session Filter")
session      = input.session("0930-1600", "Session")

// ── CORE ───────────────────────────────────────────────────────────────────

sma200 = ta.sma(close, sma200Len)
sma20  = ta.sma(close, sma20Len)
atr    = ta.atr(atrLen)

sessionOK = not useSession or not na(time(timeframe.period, session))

// ── PIVOT SWING HIGHS / LOWS (no repainting — confirmed swingLen bars later) ──

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float lastPH = na
var float lastPL = na

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// ── BREAK OF STRUCTURE (fires exactly once per swing level) ────────────────

var float bosHighUsed = na
var float bosLowUsed  = na

bullBOS = not na(lastPH) and close > lastPH and lastPH != bosHighUsed and barstate.isconfirmed
bearBOS = not na(lastPL) and close < lastPL and lastPL != bosLowUsed  and barstate.isconfirmed

if bullBOS
    bosHighUsed := lastPH
if bearBOS
    bosLowUsed  := lastPL

// ── ORDER BLOCKS ───────────────────────────────────────────────────────────
// Scan back up to 5 bars for the last opposing candle at time of BOS.
// Bearish candle before bullish BOS = demand zone; bullish before bearish BOS = supply.

var box bullOBBox = na
var box bearOBBox = na

if bullBOS and showOB
    // find last bearish candle within 5 bars
    obI = close[1] < open[1] ? 1 : close[2] < open[2] ? 2 :
         close[3] < open[3] ? 3 : close[4] < open[4] ? 4 :
         close[5] < open[5] ? 5 : 0
    if obI > 0
        box.delete(bullOBBox)
        bullOBBox := box.new(
             bar_index - obI, high[obI], bar_index + 30, low[obI],
             bgcolor       = color.new(color.green, 88),
             border_color  = color.green, border_width = 1,
             text          = "Demand", text_color = color.green,
             text_size     = size.tiny, text_halign = text.align_left,
             text_valign   = text.align_top)

if bearBOS and showOB
    obI = close[1] > open[1] ? 1 : close[2] > open[2] ? 2 :
         close[3] > open[3] ? 3 : close[4] > open[4] ? 4 :
         close[5] > open[5] ? 5 : 0
    if obI > 0
        box.delete(bearOBBox)
        bearOBBox := box.new(
             bar_index - obI, high[obI], bar_index + 30, low[obI],
             bgcolor       = color.new(color.red, 88),
             border_color  = color.red, border_width = 1,
             text          = "Supply", text_color = color.red,
             text_size     = size.tiny, text_halign = text.align_left,
             text_valign   = text.align_top)

// ── FAIR VALUE GAPS (3-candle imbalance, trend-aligned, confirmed bars) ────
// Bullish FVG: high[2] < low  → price jumped up, leaving a gap
// Bearish FVG: low[2]  > high → price dropped, leaving a gap

bullFVG = high[2] < low  and close > sma200 and barstate.isconfirmed
bearFVG = low[2]  > high and close < sma200 and barstate.isconfirmed

var box lastBullFVG = na
var box lastBearFVG = na

if bullFVG and showFVG
    box.delete(lastBullFVG)
    lastBullFVG := box.new(
         bar_index - 1, low, bar_index + 20, high[2],
         bgcolor      = color.new(color.teal, 90),
         border_color = color.new(color.teal, 50), border_width = 1,
         text         = "FVG", text_color = color.new(color.teal, 20),
         text_size    = size.tiny, text_halign = text.align_left,
         text_valign  = text.align_top)

if bearFVG and showFVG
    box.delete(lastBearFVG)
    lastBearFVG := box.new(
         bar_index - 1, low[2], bar_index + 20, high,
         bgcolor      = color.new(color.orange, 90),
         border_color = color.new(color.orange, 50), border_width = 1,
         text         = "FVG", text_color = color.new(color.orange, 20),
         text_size    = size.tiny, text_halign = text.align_left,
         text_valign  = text.align_top)

// ── DISCOUNT / PREMIUM ZONE (requires both pivots confirmed) ───────────────

pivotsDefined = not na(lastPH) and not na(lastPL)
midPoint      = pivotsDefined ? (lastPH + lastPL) / 2 : na
inDiscount    = pivotsDefined and close < midPoint
inPremium     = pivotsDefined and close > midPoint

discOK = not useDisc or inDiscount
premOK = not useDisc or inPremium

// ── CANDLE QUALITY ─────────────────────────────────────────────────────────

body      = math.abs(close - open)
cRange    = high - low
validBull = close > open and body > cRange * 0.4
validBear = close < open and body > cRange * 0.4

// ── TREND ──────────────────────────────────────────────────────────────────

bullTrend = close > sma200
bearTrend = close < sma200

// ── SIGNALS ────────────────────────────────────────────────────────────────

longSignal  = bullBOS and validBull and bullTrend and discOK and sessionOK
shortSignal = bearBOS and validBear and bearTrend and premOK and sessionOK

// ── STATE ──────────────────────────────────────────────────────────────────

var bool  inLong     = false
var bool  inShort    = false
var float entryPrice = na
var float stopPrice  = na
var float takePrice  = na

if longSignal and not inLong and not inShort
    inLong     := true
    entryPrice := close
    slATR      = close - atr * atrMult
    // Stop below last swing low if within 3 ATR; else use ATR stop
    slSwing    = not na(lastPL) ? lastPL - atr * 0.2 : slATR
    stopPrice  := (not na(lastPL) and (close - lastPL) < atr * 3.0) ? slSwing : slATR
    takePrice  := entryPrice + (entryPrice - stopPrice) * rr

if shortSignal and not inShort and not inLong
    inShort    := true
    entryPrice := close
    slATR      = close + atr * atrMult
    // Stop above last swing high if within 3 ATR; else use ATR stop
    slSwing    = not na(lastPH) ? lastPH + atr * 0.2 : slATR
    stopPrice  := (not na(lastPH) and (lastPH - close) < atr * 3.0) ? slSwing : slATR
    takePrice  := entryPrice - (stopPrice - entryPrice) * rr

// ── EXITS — split by reason so each gets its own label ────────────────────

sma20ExitLong  = useSMA20Exit and ta.crossunder(close, sma20)
sma20ExitShort = useSMA20Exit and ta.crossover(close,  sma20)

// Detect each exit reason independently (before state is cleared)
longTP   = inLong  and high >= takePrice
longSL   = inLong  and low  <= stopPrice
longSMA  = inLong  and sma20ExitLong and not longTP and not longSL

shortTP  = inShort and low  <= takePrice
shortSL  = inShort and high >= stopPrice
shortSMA = inShort and sma20ExitShort and not shortTP and not shortSL

longExit  = longTP  or longSL  or longSMA
shortExit = shortTP or shortSL or shortSMA

if longExit
    inLong  := false
if shortExit
    inShort := false

// ── VISUALS ────────────────────────────────────────────────────────────────

// Subtle background while trade is open
bgcolor(inLong  ? color.new(color.green, 97) : na, title="Long Trade BG")
bgcolor(inShort ? color.new(color.red,   97) : na, title="Short Trade BG")

// Moving averages
plot(sma200, "SMA 200", color=color.white, linewidth=2)
plot(sma20,  "SMA 20",  color=color.blue,  linewidth=2)

// Live structure levels
plot(lastPH, "Swing High", color=color.new(color.red,  50), linewidth=1)
plot(lastPL, "Swing Low",  color=color.new(color.lime, 50), linewidth=1)

// Midpoint line (only visible when discount/premium filter is on)
plot(useDisc and pivotsDefined ? midPoint : na, "Range Mid",
     color=color.new(color.yellow, 60), linewidth=1, style=plot.style_circles)

// ── ENTRY LABELS ───────────────────────────────────────────────────────────

plotshape(longSignal, title="BUY",
     style=shape.labelup, location=location.belowbar,
     color=color.green, size=size.normal,
     text="BUY", textcolor=color.white)

plotshape(shortSignal, title="SELL",
     style=shape.labeldown, location=location.abovebar,
     color=color.red, size=size.normal,
     text="SELL", textcolor=color.white)

// BOS events filtered out by trend / candle / session
plotshape(bullBOS and not longSignal, title="BOS ↑",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 30), size=size.tiny, text="BOS")
plotshape(bearBOS and not shortSignal, title="BOS ↓",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 30), size=size.tiny, text="BOS")

// ── ACTIVE TRADE LEVELS ────────────────────────────────────────────────────

plot(inLong or inShort ? entryPrice : na, "Entry",
     color=color.gray,  linewidth=1, style=plot.style_linebr)
plot(inLong or inShort ? stopPrice  : na, "SL",
     color=color.red,   linewidth=2, style=plot.style_linebr)
plot(inLong or inShort ? takePrice  : na, "TP",
     color=color.lime,  linewidth=2, style=plot.style_linebr)

// ── EXIT LABELS (per reason, per direction) ────────────────────────────────

// Long TP hit — green label above bar
plotshape(longTP, title="Long TP",
     style=shape.labeldown, location=location.abovebar,
     color=color.new(color.lime, 10), size=size.small,
     text="TP", textcolor=color.white)

// Long SL hit — red label above bar
plotshape(longSL, title="Long SL",
     style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 10), size=size.small,
     text="SL", textcolor=color.white)

// Long SMA20 exit — orange label above bar
plotshape(longSMA, title="Long Exit (SMA)",
     style=shape.labeldown, location=location.abovebar,
     color=color.new(color.orange, 10), size=size.small,
     text="Exit", textcolor=color.white)

// Short TP hit — teal label below bar
plotshape(shortTP, title="Short TP",
     style=shape.labelup, location=location.belowbar,
     color=color.new(color.lime, 10), size=size.small,
     text="TP", textcolor=color.white)

// Short SL hit — red label below bar
plotshape(shortSL, title="Short SL",
     style=shape.labelup, location=location.belowbar,
     color=color.new(color.red, 10), size=size.small,
     text="SL", textcolor=color.white)

// Short SMA20 exit — orange label below bar
plotshape(shortSMA, title="Short Exit (SMA)",
     style=shape.labelup, location=location.belowbar,
     color=color.new(color.orange, 10), size=size.small,
     text="Exit", textcolor=color.white)

// ── ALERTS ─────────────────────────────────────────────────────────────────

alertcondition(longSignal,  "BUY Signal",     "BUY — Bullish BOS confirmed")
alertcondition(shortSignal, "SELL Signal",    "SELL — Bearish BOS confirmed")
alertcondition(longTP,      "Long TP Hit",    "Long trade reached Take Profit")
alertcondition(longSL,      "Long SL Hit",    "Long trade hit Stop Loss")
alertcondition(longSMA,     "Long SMA Exit",  "Long trade exited on SMA20 cross")
alertcondition(shortTP,     "Short TP Hit",   "Short trade reached Take Profit")
alertcondition(shortSL,     "Short SL Hit",   "Short trade hit Stop Loss")
alertcondition(shortSMA,    "Short SMA Exit", "Short trade exited on SMA20 cross")

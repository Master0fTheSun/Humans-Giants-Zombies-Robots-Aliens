//@version=6
indicator("Model B – Buy / Sell", overlay=true)

// ── SETTINGS ───────────────────────────────────────────────────────────────

trendLen   = input.int(200,  "Trend MA")
fastLen    = input.int(20,   "Signal MA")
swingLen   = input.int(10,   "Swing Lookback")
atrLen     = input.int(14,   "ATR Length")
atrMult    = input.float(1.5,"Stop Mult",  step=0.1)
rrRatio    = input.float(2.0,"R:R",        step=0.1)
useSession = input.bool(true, "NY Session Only")
session    = input.session("0930-1600", "Session")

// ── INDICATORS ─────────────────────────────────────────────────────────────

sma200    = ta.sma(close, trendLen)
sma20     = ta.sma(close, fastLen)
atr       = ta.atr(atrLen)
sessionOK = not useSession or not na(time(timeframe.period, session))

// ── SWING LEVELS ───────────────────────────────────────────────────────────

swHigh = ta.highest(high, swingLen)[1]
swLow  = ta.lowest(low,  swingLen)[1]

// ── CANDLE QUALITY ─────────────────────────────────────────────────────────

body     = math.abs(close - open)
rng      = high - low
solidBar = rng > 0 and body / rng >= 0.4

// ── STATE ──────────────────────────────────────────────────────────────────

var bool  inLong  = false
var bool  inShort = false
var float entry   = na
var float sl      = na
var float tp      = na

// ── SIGNALS (evaluated before state changes so plotshape sees them) ────────

buySignal  = close > swHigh and close > open and solidBar
             and close > sma200
             and not inLong and not inShort
             and sessionOK and barstate.isconfirmed

sellSignal = close < swLow  and close < open and solidBar
             and close < sma200
             and not inShort and not inLong
             and sessionOK and barstate.isconfirmed

// ── ENTRIES ────────────────────────────────────────────────────────────────

if buySignal
    inLong  := true
    entry   := close
    sl      := close - atr * atrMult
    tp      := close + (close - sl) * rrRatio

if sellSignal
    inShort := true
    entry   := close
    sl      := close + atr * atrMult
    tp      := close - (sl - close) * rrRatio

// ── EXITS ──────────────────────────────────────────────────────────────────

longExit  = inLong  and (low  <= sl or high >= tp or ta.crossunder(close, sma20))
shortExit = inShort and (high >= sl or low  <= tp or ta.crossover(close,  sma20))

if longExit
    inLong  := false
if shortExit
    inShort := false

// ── VISUALS ────────────────────────────────────────────────────────────────

plot(sma200, "200 MA", color=color.white, linewidth=2)
plot(sma20,  "20 MA",  color=color.blue,  linewidth=2)

// Active trade levels
plot(inLong or inShort ? entry : na, "Entry", color=color.gray,  linewidth=1, style=plot.style_linebr)
plot(inLong or inShort ? sl    : na, "SL",    color=color.red,   linewidth=2, style=plot.style_linebr)
plot(inLong or inShort ? tp    : na, "TP",    color=color.lime,  linewidth=2, style=plot.style_linebr)

// BUY label — huge green arrow below bar
plotshape(buySignal, title="BUY",
     style=shape.labelup, location=location.belowbar,
     color=color.green, size=size.huge,
     text="BUY", textcolor=color.white)

// SELL label — huge red arrow above bar
plotshape(sellSignal, title="SELL",
     style=shape.labeldown, location=location.abovebar,
     color=color.red, size=size.huge,
     text="SELL", textcolor=color.white)

// EXIT label — orange, long exits above bar / short exits below bar
plotshape(longExit, title="EXIT Long",
     style=shape.labeldown, location=location.abovebar,
     color=color.orange, size=size.large,
     text="EXIT", textcolor=color.white)

plotshape(shortExit, title="EXIT Short",
     style=shape.labelup, location=location.belowbar,
     color=color.orange, size=size.large,
     text="EXIT", textcolor=color.white)

// ── ALERTS ─────────────────────────────────────────────────────────────────

alertcondition(buySignal,  "BUY",        "BUY signal fired")
alertcondition(sellSignal, "SELL",       "SELL signal fired")
alertcondition(longExit,   "Long Exit",  "Long position exited")
alertcondition(shortExit,  "Short Exit", "Short position exited")

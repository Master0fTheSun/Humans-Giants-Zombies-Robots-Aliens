//@version=6
indicator("Venice Basic", shorttitle="Venice Basic", overlay=true, max_lines_count=200, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// — EMA —
ema1_len      = input.int(9,    "Fast EMA Length",              minval=1,          group="EMA Settings")
ema2_len      = input.int(21,   "Mid EMA Length",               minval=1,          group="EMA Settings")
ema3_len      = input.int(50,   "Slow EMA Length",              minval=1,          group="EMA Settings")

// — RSI —
rsi_len       = input.int(14,   "RSI Length",                   minval=1,          group="RSI Settings")
rsi_ob        = input.int(70,   "Overbought Level",             minval=55,         group="RSI Settings")
rsi_os        = input.int(30,   "Oversold Level",               maxval=45,         group="RSI Settings")

// — Volume —
vol_len       = input.int(20,   "Volume MA Length",             minval=1,          group="Volume Settings")
vol_mult      = input.float(1.3,"Volume Multiplier",            minval=1.0, step=0.1, group="Volume Settings",
                 tooltip="Volume must be this multiple of the average to count as 'elevated'")

// — Signal —
score_thresh  = input.int(4,    "Signal Threshold (out of 5)",  minval=1, maxval=5, group="Signal Settings",
                 tooltip="How many of the 5 layers must agree before a BUY or SELL arrow prints. Default: 4")

// — Display —
show_emas       = input.bool(true,  "Show EMAs",                            group="Display")
show_vwap       = input.bool(true,  "Show VWAP",                            group="Display")
show_vwap_bands = input.bool(false, "Show VWAP ±1 SD Bands",               group="Display")
show_candle_clr = input.bool(true,  "Color Candles by Trend",               group="Display")
show_dashboard  = input.bool(true,  "Show Dashboard",                       group="Display")
show_or         = input.bool(true,  "Show Opening Range (9:30–9:45 ET)",    group="Display",
                 tooltip="Highlights the high/low of the first 15 minutes of the RTH session")
show_pd         = input.bool(true,  "Show Previous Day High / Low",         group="Display")

// ══════════════════════════════════════════════════════════════════════════════
//  CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// — EMAs —
ema9  = ta.ema(close, ema1_len)
ema21 = ta.ema(close, ema2_len)
ema50 = ta.ema(close, ema3_len)

// — RSI —
rsi_val = ta.rsi(close, rsi_len)

// — Volume —
vol_avg = ta.sma(volume, vol_len)

// — VWAP (session-anchored, resets at daily bar rollover) —
var float cum_vol  = 0.0
var float cum_tp   = 0.0
var float cum_tp2  = 0.0
is_new_day = ta.change(time("D")) != 0 or bar_index == 0

cum_vol  := is_new_day ? volume                        : cum_vol  + volume
cum_tp   := is_new_day ? hlc3 * volume                 : cum_tp   + hlc3 * volume
cum_tp2  := is_new_day ? math.pow(hlc3, 2) * volume    : cum_tp2  + math.pow(hlc3, 2) * volume

vwap_val = cum_tp / cum_vol
vwap_sd  = math.sqrt(math.max(cum_tp2 / cum_vol - math.pow(vwap_val, 2), 0.0))
vwap_up  = vwap_val + vwap_sd
vwap_dn  = vwap_val - vwap_sd

// — Previous Day High / Low —
pdh = request.security(syminfo.tickerid, "D", high[1])
pdl = request.security(syminfo.tickerid, "D", low[1])

// — Opening Range  (9:30–9:45 ET, first 3 bars on 5m) —
in_or_period = not na(time(timeframe.period, "0930-0945", "America/New_York"))

var float or_high = na
var float or_low  = na
var bool  or_set  = false

if is_new_day
    or_high := na
    or_low  := na
    or_set  := false

if in_or_period
    or_high := na(or_high) ? high : math.max(or_high, high)
    or_low  := na(or_low)  ? low  : math.min(or_low,  low)
    or_set  := true

// ══════════════════════════════════════════════════════════════════════════════
//  SIGNAL LAYERS  (each contributes 0 or 1 to the bull/bear score)
// ══════════════════════════════════════════════════════════════════════════════

bar_range = math.max(high - low, syminfo.mintick)

// Layer 1 — EMA Stack Alignment
trend_bull = ema9 > ema21 and ema21 > ema50 and close > ema9 ? 1 : 0
trend_bear = ema9 < ema21 and ema21 < ema50 and close < ema9 ? 1 : 0

// Layer 2 — VWAP Side
vwap_bull = close > vwap_val ? 1 : 0
vwap_bear = close < vwap_val ? 1 : 0

// Layer 3 — RSI Momentum (not at an extreme)
rsi_bull = rsi_val > 50 and rsi_val < rsi_ob ? 1 : 0
rsi_bear = rsi_val < 50 and rsi_val > rsi_os ? 1 : 0

// Layer 4 — Elevated Volume
vol_ok = volume >= vol_avg * vol_mult ? 1 : 0

// Layer 5 — Momentum Candle (close in top/bottom 70% of bar range)
trig_bull = close > open and (close - low)  / bar_range >= 0.70 ? 1 : 0
trig_bear = close < open and (high - close) / bar_range >= 0.70 ? 1 : 0

// — Confluence Scores —
bull_score = trend_bull + vwap_bull + rsi_bull + vol_ok + trig_bull
bear_score = trend_bear + vwap_bear + rsi_bear + vol_ok + trig_bear

buy_signal  = bull_score >= score_thresh
sell_signal = bear_score >= score_thresh

// ══════════════════════════════════════════════════════════════════════════════
//  PLOTS
// ══════════════════════════════════════════════════════════════════════════════

// — EMAs —
plot(show_emas ? ema9  : na, "EMA 9",  color=color.new(#2196F3, 0),  linewidth=1)
plot(show_emas ? ema21 : na, "EMA 21", color=color.new(#9E9E9E, 10), linewidth=1)
plot(show_emas ? ema50 : na, "EMA 50", color=color.new(#FF9800, 0),  linewidth=2)

// — VWAP —
plot(show_vwap ? vwap_val : na,        "VWAP",       color=color.new(#00BCD4, 0),  linewidth=2)
plot(show_vwap_bands ? vwap_up : na,   "VWAP +1 SD", color=color.new(#00BCD4, 60), linewidth=1)
plot(show_vwap_bands ? vwap_dn : na,   "VWAP -1 SD", color=color.new(#00BCD4, 60), linewidth=1)

// — Opening Range —
plot(show_or and or_set ? or_high : na, "OR High", color=color.new(#66BB6A, 20), linewidth=1, style=plot.style_stepline)
plot(show_or and or_set ? or_low  : na, "OR Low",  color=color.new(#EF5350, 20), linewidth=1, style=plot.style_stepline)

// — Previous Day High / Low —
plot(show_pd ? pdh : na, "PDH", color=color.new(#5C6BC0, 20), linewidth=1, style=plot.style_stepline)
plot(show_pd ? pdl : na, "PDL", color=color.new(#FF7043, 20), linewidth=1, style=plot.style_stepline)

// — Candle Coloring —
barcolor(show_candle_clr
     ? (trend_bull == 1 ? color.new(color.green, 55)
     :  trend_bear == 1 ? color.new(color.red,   55)
     :  na)
     : na,
     title="Trend Candle Color")

// — Signal Arrows —
plotshape(buy_signal,  title="BUY Signal",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(#00E676, 0), textcolor=color.black, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL Signal", style=shape.triangledown, location=location.abovebar,
     color=color.new(#FF1744, 0), textcolor=color.white, size=size.small, text="SELL")

// ══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD TABLE
// ══════════════════════════════════════════════════════════════════════════════

c_green  = color.new(#26A69A, 10)
c_red    = color.new(#EF5350, 10)
c_gray   = color.new(#37474F, 20)
c_yellow = color.new(#FFA726, 10)
c_header = color.new(#1A237E, 5)
c_white  = color.white
ts       = size.small

var table dash = table.new(position.top_right, 2, 8,
     bgcolor      = color.new(#0D0D0D, 5),
     border_width = 1,
     border_color = color.new(color.gray, 50),
     frame_width  = 1,
     frame_color  = color.new(color.gray, 30))

if show_dashboard
    // Row 0 — Header
    table.cell(dash, 0, 0, "VENICE  BASIC",
         text_color=c_white, bgcolor=c_header, text_size=size.normal, text_halign=text.align_center)
    table.cell(dash, 1, 0, syminfo.ticker,
         text_color=color.new(color.silver, 10), bgcolor=c_header, text_size=size.tiny, text_halign=text.align_center)

    // Row 1 — EMA Trend
    trend_txt = trend_bull == 1 ? "▲  BULL" : trend_bear == 1 ? "▼  BEAR" : "—  Flat"
    trend_bg  = trend_bull == 1 ? c_green   : trend_bear == 1 ? c_red     : c_gray
    table.cell(dash, 0, 1, "Trend (EMA)", text_color=c_white, bgcolor=c_gray,  text_size=ts)
    table.cell(dash, 1, 1, trend_txt,     text_color=c_white, bgcolor=trend_bg, text_size=ts)

    // Row 2 — VWAP
    vwap_txt = close > vwap_val ? "Above  ▲" : "Below  ▼"
    vwap_bg  = close > vwap_val ? c_green     : c_red
    table.cell(dash, 0, 2, "VWAP",   text_color=c_white, bgcolor=c_gray,   text_size=ts)
    table.cell(dash, 1, 2, vwap_txt, text_color=c_white, bgcolor=vwap_bg,  text_size=ts)

    // Row 3 — RSI
    rsi_tag = rsi_val >= rsi_ob ? "  OB" : rsi_val <= rsi_os ? "  OS" : "  ✓"
    rsi_bg  = rsi_bull == 1 ? c_green : rsi_bear == 1 ? c_red : c_gray
    table.cell(dash, 0, 3, "RSI (" + str.tostring(rsi_len) + ")",         text_color=c_white, bgcolor=c_gray, text_size=ts)
    table.cell(dash, 1, 3, str.tostring(math.round(rsi_val, 1)) + rsi_tag, text_color=c_white, bgcolor=rsi_bg, text_size=ts)

    // Row 4 — Volume
    vol_txt = vol_ok == 1 ? "High  ✓" : "Normal"
    vol_bg  = vol_ok == 1 ? c_green    : c_gray
    table.cell(dash, 0, 4, "Volume", text_color=c_white, bgcolor=c_gray,  text_size=ts)
    table.cell(dash, 1, 4, vol_txt,  text_color=c_white, bgcolor=vol_bg,  text_size=ts)

    // Row 5 — Trigger Candle
    trig_txt = trig_bull == 1 ? "Bull  ✓" : trig_bear == 1 ? "Bear  ✓" : "—  Weak"
    trig_bg  = trig_bull == 1 ? c_green   : trig_bear == 1 ? c_red     : c_gray
    table.cell(dash, 0, 5, "Trigger", text_color=c_white, bgcolor=c_gray,  text_size=ts)
    table.cell(dash, 1, 5, trig_txt,  text_color=c_white, bgcolor=trig_bg, text_size=ts)

    // Row 6 — Confluence Score
    active_score = math.max(bull_score, bear_score)
    score_bg = active_score >= score_thresh ? c_green : active_score >= score_thresh - 1 ? c_yellow : c_red
    table.cell(dash, 0, 6, "Score",                                  text_color=c_white, bgcolor=c_gray,    text_size=ts)
    table.cell(dash, 1, 6, str.tostring(active_score) + "  /  5",   text_color=c_white, bgcolor=score_bg,  text_size=ts)

    // Row 7 — Signal Banner
    sig_txt = buy_signal ? "◆  BUY  SIGNAL" : sell_signal ? "◆  SELL  SIGNAL" : "    Watching..."
    sig_bg  = buy_signal ? c_green : sell_signal ? c_red : c_gray
    table.cell(dash, 0, 7, sig_txt, text_color=c_white, bgcolor=sig_bg, text_size=ts, text_halign=text.align_center)
    table.cell(dash, 1, 7, "",      text_color=c_white, bgcolor=sig_bg, text_size=ts)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(buy_signal,  "Venice Basic — BUY",  "Venice Basic: BUY signal on {{ticker}} ({{interval}})")
alertcondition(sell_signal, "Venice Basic — SELL", "Venice Basic: SELL signal on {{ticker}} ({{interval}})")
